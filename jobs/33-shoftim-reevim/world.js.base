];
function keys(t, K) {
  if (t <= K[0][0]) return K[0][1];
  // two keys = one steady drift that keeps moving through the cut (no ease-out stall)
  if (K.length === 2) { const s = (t - K[0][0]) / (K[1][0] - K[0][0]); return K[0][1].map((v, j) => v + (K[1][1][j] - v) * s); }
  let i = 0;
  while (i < K.length - 2 && t > K[i + 1][0]) i++;
  const s = Math.min(1, (t - K[i][0]) / (K[i + 1][0] - K[i][0]));
  const p0 = (K[i - 1] || K[i])[1], p1 = K[i][1], p2 = K[i + 1][1], p3 = (K[i + 2] || K[i + 1])[1];
  return p1.map((_, j) => 0.5 * (2 * p1[j] + (-p0[j] + p2[j]) * s + (2 * p0[j] - 5 * p1[j] + 4 * p2[j] - p3[j]) * s * s + (-p0[j] + 3 * p1[j] - 3 * p2[j] + p3[j]) * s * s * s));
}
const pop = (a, u) => { const s = Math.min(1, Math.max(0, (u - a + 0.05) / 0.35)); return 0.01 + 0.99 * (1 - (1 - s) ** 3); }; // scale-in for things that appear on a word
const cl = (x) => Math.min(1, Math.max(0, x));
const hash = (n) => { const v = Math.sin(n * 12.9898 + 1.7) * 43758.5453; return v - Math.floor(v); };
const valAt = (p) => { const i = Math.min(PTS.length - 2, Math.floor(p)), f = p - i; return PTS[i][1] + (PTS[i + 1][1] - PTS[i][1]) * f; };
const slam = (x) => (x < 0 ? 0 : x < 0.08 ? x / 0.08 : x < 0.18 ? 1 : 1 - sm(0.18, 0.43, x)); // gavel down/up
shock.material.transparent = true;
// chart progress (in segments) for s2/s3
function progAt(id, u) {
  if (id === "s2") return 6 * cl((u - at("s2", "ככל")) / (at("s2", "לאפס") + 0.25 - at("s2", "ככל")));
  const q = at("s3", "קפץ");
  return 6 + cl((u - q + 0.05) / 0.25) + 2 * cl((u - q - 0.4) / 1.2);
}
const P2 = 0.42, C0 = 0.15; // one decision card every P2 s in s2
const approve = (n, u) => { const v = valAt(progAt("s2", C0 + n * P2)); return v >= 0.6 ? n % 3 !== 2 : hash(n) < v * 1.1; };

const m4 = new THREE.Matrix4();
function drawAt(t) {
  dust.visible = true;
  let id = IDS[0];
  for (const k of IDS) if (t >= S[k][0]) id = k;
  const u = t - S[id][0] - LEAD;
  dust.position.y = 0.12 * Math.sin(t * 0.4); dust.rotation.y = t * 0.004;
  if (id === "h1" || id === "h2") return renderHook(t, id, u);
  let shot = SH[0];
  for (const s of SH) if (t >= s.at) shot = s;
  const su = t - shot.at;
  resetHook();

  const court = id === "s1" || id === "s2" || id === "s3";
  GC.visible = court; G4.visible = id === "s4"; G5.visible = id === "s5"; G6.visible = id === "s6"; G7.visible = id === "s7";
  scene.fog.density = 0.03;

  if (court) {
    const s1 = id === "s1", s2 = id === "s2", s3 = id === "s3";
    // s1 props
    t2011.visible = s1 && u < at("s1", "מאלף") - 0.05; t2011.scale.setScalar(pop(0.05, u));
    RES.forEach((r) => { r.visible = s1 && u > at("s1", "חוקרים"); r.scale.setScalar(pop(at("s1", "חוקרים"), u)); });
    const fa = at("s1", "מאלף");
    files.visible = s1 && u > fa - 0.3;
    if (files.visible) {
      FL.forEach((F, i) => { const k = sm(fa - 0.3 + F.d * 0.7, fa - 0.1 + F.d * 0.7, u); m4.makeScale(Math.max(0.001, k), Math.max(0.001, k), 1).setPosition(F.x, F.y + 0.3 * (1 - k), -2.2); files.setMatrixAt(i, m4); });
      files.instanceMatrix.needsUpdate = true;
    }
    tCount.visible = tDec.visible = cntBack.visible = s1 && u > fa - 0.1;
    tCount.userData.set(String(Math.round(1112 * sm(fa - 0.1, fa + 0.8, u))));
    tCount.scale.setScalar(pop(fa, u)); tDec.scale.setScalar(pop(fa + 0.3, u));
    flag.visible = s1 && u > at("s1", "שופטים") - 0.2;
    cloth.position.y = 0.9 + 1.55 * sm(at("s1", "בישראל") - 0.25, at("s1", "בישראל") + 0.35, u);
    const sh = at("s1", "שחרור");
    bars.position.x = s1 ? 1.9 * sm(sh + 0.1, sh + 0.7, u) : 0;
    prisoner.position.set(0, 0, -0.4 + 1.3 * (s1 ? sm(sh + 0.35, sh + 1.05, u) : 0));
    freeLight.visible = false;
    // chart board
    board.visible = !s1;
    const prog = s1 ? 0 : progAt(id, u), val = valAt(prog);
    SEG.forEach((G, i) => { const k = cl(prog - i); G.s.visible = k > 0.001; G.bar.scale.x = Math.max(0.001, k * G.L); });
    const hi = Math.min(PTS.length - 2, Math.floor(prog)), hf = prog - hi;
    head.position.set(PTS[hi][0] + (PTS[hi + 1][0] - PTS[hi][0]) * hf, yv(val), -2.1);
    const shown = s3 || u > at("s2", "שני") - 0.1;
    tPct.visible = t65.visible = shown;
    tPct.userData.set(Math.round(val * 100) + "%");
    tPct.material.color.set(val > 0.5 ? GREEN : val > 0.2 ? ORANGE : RED).multiplyScalar(val > 0.5 ? 0.9 : 1.3);
    tPct.scale.setScalar(s2 ? pop(at("s2", "שני"), u) : 1 + 0.25 * (sm(at("s3", "קפץ"), at("s3", "קפץ") + 0.15, u) - sm(at("s3", "חזרה"), at("s3", "חזרה") + 0.4, u)));
    icon.visible = brk.visible = s3 && u > at("s3", "אוכל") - 0.1; icon.scale.setScalar(0.55 * pop(at("s3", "אוכל"), u));
    // wall clock: 9:00 -> 12:40 while the hours pass, a bit more over lunch
    const hr = s2 ? 9 + 3.67 * cl((u - at("s2", "ככל")) / (at("s2", "לאפס") - at("s2", "ככל"))) : 12.67 + 0.6 * cl(u / 3);
    pHour.rotation.z = -(hr % 12) / 12 * Math.PI * 2; pMin.rotation.z = -(hr % 1) * Math.PI * 2;
    // judge: tired as approvals fall, fresh after lunch
    const ate = at("s3", "אוכל"), tired = s2 ? 0.9 * sm(at("s2", "ככל"), at("s2", "לאפס") + 0.3, u) : s3 ? 0.9 * (1 - sm(ate + 0.2, ate + 0.9, u)) : 0;
    const bite = s3 ? Math.max(0, Math.sin(Math.PI * cl((u - ate) / 0.35))) + Math.max(0, Math.sin(Math.PI * cl((u - ate - 0.4) / 0.35))) : 0;
    jdg.visible = !shot.board;
    slumpJudge(jdg, tired); jdg.rotation.x += 0.28 * bite;
    lerpMat(mJudge, FRESH, TIRED, tired);
    // lunch
    lunch.visible = s3;
    lunch.position.x = 0.55 + 1.9 * (1 - sm(at("s3", "הגיעה") - 0.1, ate, u));
    lunch.children.slice(1).forEach((c) => (c.scale.x = 1 - 0.3 * cl((u - ate - 0.15) / 0.3) - 0.3 * cl((u - ate - 0.55) / 0.3)));
    // decision cards + gavel
    let gv = s1 ? Math.max(slam(u - 0.22), slam(u - 1.0)) : 0;
    cardG.visible = s2 && u > C0;
    let nOk = 0, nNo = 0;
    if (s2 || s3) {
      const n = s2 ? Math.floor((u - C0) / P2) : Math.floor((at("s2", "לאפס") + 0.6 - C0) / P2), ph = s2 ? (u - C0) / P2 - n : 1;
      for (let k = 0; k < n; k++) approve(k) ? nOk++ : nNo++;
      if (s2 && n >= 0) {
        const ok = approve(n), rise = sm(0, 0.18, ph), go = sm(0.72, 1, ph);
        cardG.position.set((ok ? -1.2 : 1.25) * go, 1.3 + 0.48 * rise - 0.2 * go, 0.05);
        cardG.scale.setScalar(Math.max(0.01, rise * (1 - 0.7 * go)));
        stOk.visible = ok && ph > 0.42; stNo.visible = !ok && ph > 0.42;
        (ok ? stOk : stNo).scale.setScalar(1 + 0.5 * (1 - sm(0.42, 0.52, ph)));
        gv = slam((ph - 0.34) * P2);
      }
    }
    if (s1 && u < at("s1", "חוקרים")) { cardG.visible = true; cardG.position.set(-0.32, 1.78, 0.45); cardG.scale.setScalar(pop(0.1, u)); stOk.visible = false; stNo.visible = u > 0.3; stNo.scale.setScalar(1 + 0.5 * (1 - sm(0.3, 0.42, u))); }
    gavel.rotation.z = -0.8 * (1 - gv);
    const sx = s1 ? (u > 1.08 ? u - 1.08 : u - 0.33) : s2 ? (((u - C0) / P2) % 1 - 0.42) * P2 : -1;
    shock.visible = sx > 0 && sx < 0.4; shock.scale.setScalar(1 + 5 * sx); shock.material.opacity = 1 - sx / 0.4;
    pileOk.visible = pileNo.visible = !s1;
    [[pileOk, nOk], [pileNo, nNo]].forEach(([p, c]) => { const h = 0.02 + 0.035 * c; p.scale.y = h; p.position.y = 1.3 + h / 2; });
  } else if (id === "s4") {
    const sf = at("s4", "סוגי"), ch = at("s4", "מה"), ty = at("s4", "עייפים"), hg = at("s4", "ורעבים");
    J4.forEach((J, i) => {
      J.j.scale.setScalar(pop(0.06, u));
      J.folder.visible = u > sf - 0.1; J.folder.scale.setScalar(1.4 * pop(sf, u));
      J.lab.visible = u > ch - 0.1; J.lab.scale.setScalar(pop(ch, u));
      const s = i ? sm(ty - 0.1, ty + 0.4, u) : 0;
      slumpJudge(J.j, s); lerpMat(J.mat, FRESH, TIRED, s);
    });
    eqs.visible = u > at("s4", "שופטים") - 0.1;
    eqs.scale.setScalar(1 + 0.35 * (Math.max(0, Math.sin(Math.PI * cl((u - at("s4", "שופטים")) / 0.4))) + Math.max(0, Math.sin(Math.PI * cl((u - at("s4", "תיקים")) / 0.4)))));
    ZZ.forEach((z, i) => { const zt = ty + 0.1 + i * 0.15; z.visible = u > zt; z.position.set(1.15 + i * 0.15, 1.55 + i * 0.2 + 0.12 * cl(u - zt), 0.1); });
    plate.visible = u > hg - 0.1; plate.scale.setScalar(pop(hg, u));
  } else if (id === "s5") {
    const a8 = at("s5", "אחרי"), tired = sm(at("s5", "הוא") - 0.1, at("s5", "לא") + 0.2, u), bq = at("s5", "הבוקר");
    let n = 0;
    CV.forEach((c, i) => { const ti = a8 + 0.05 + i * 0.12; c.visible = u > ti; if (u > ti) n = i + 1; c.position.y = 0.83 + i * 0.026 + 0.35 * (1 - sm(ti, ti + 0.1, u)); });
    tN.visible = tInt.visible = n > 0; tN.userData.set(String(n)); tN.scale.setScalar(pop(a8 + 0.05 + (n - 1) * 0.12, u));
    const last = a8 + 0.05 + Math.max(0, n - 1) * 0.12, CC = [0x9a90ff, 0xff9a5a, 0x6ad0ff, 0xe8e4ff];
    candidate.scale.setScalar(n > 0 && n < 8 || u < a8 + 1.0 ? 0.7 + 0.3 * sm(last, last + 0.1, u) : 1);
    candidate.children[0].material.color.set(CC[n % 4]);
    slumpSeat(interviewer, tired); lerpMat(mInt, FRESH, TIRED, tired);
    const k = 1 - 0.8 * tired;
    bulbM.color.set(GOLD).multiplyScalar(1.6 * k); beamM.opacity = 0.1 * k; lampLight.intensity = 6 * k;
    const day = sm(0, at("s5", "הוא"), u);
    skyM.color.set(0x5ab0ff).lerp(new THREE.Color(0xff7a30), sm(0, 0.6, day)).lerp(new THREE.Color(0x1a1640), sm(0.6, 1, day)).multiplyScalar(0.7);
    sun.position.y = 0.28 - 0.55 * day; sun.scale.setScalar(Math.max(0.001, 1 - sm(0.75, 1, day)));
    ghost.visible = tMorning.visible = u > bq - 0.15; tMorning.scale.setScalar(pop(bq, u));
  } else if (id === "s6") {
    const qa = at("s6", "שואל"), qb = at("s6", "שאלות"), sa = at("s6", "נותן"), br = at("s6", "ומתאם");
    CR.forEach((C, i) => {
      const qt = qa + (i / 5) * 0.6 * (qb + 0.3 - qa);
      C.bubble.visible = u > qt && u < sa + i * 0.12 + 0.1;
      const fly = sm(qt, qt + 0.3, u); // "?" drops from the question line into its row
      const dn = sm(qt, qt + 0.15, u); C.bubble.position.set(-1.25 + 1.95 * fly, (5.95 - (5.55 - i * 0.62)) * (1 - dn), 0.06);
      const fill = sm(sa + i * 0.12, sa + i * 0.12 + 0.5, u), w = 1.3 * (C.s / 10) * fill + 0.001;
      C.bar.scale.x = w; C.bar.position.x = 0.55 - w / 2;
      C.num.visible = fill > 0.6;
      const top = RANK[i] < 3, s0 = br + 0.35 + 0.12 * RANK[i], sort = top ? sm(s0, s0 + 0.5, u) : 0;
      const y = 5.55 - i * 0.62, y2 = 5.55 - RANK[i] * 0.62;
      // movers fold shut, then reopen in their new slot, so rows never pass through each other
      const flip = y2 !== y ? Math.abs(1 - 2 * sort) : 1;
      C.row.position.set(0, sort < 0.5 ? y : y2, 0.02);
      C.bg.material = top && sort > 0.5 ? mWarm : mSolid;
      const gone = top ? 0 : sm(br, br + 0.35, u);
      C.row.scale.set(1, Math.max(0.001, Math.min(flip, sm(0.05 + i * 0.1, 0.3 + i * 0.1, u)) - 0.999 * gone), 1); C.row.visible = gone < 0.97 && u > 0.05 + i * 0.1;
      C.bar.material.color.set(top && sort > 0.5 ? ORANGE : VIOLET).multiplyScalar(top && sort > 0.5 ? 1.5 : 0.9);
    });
  } else if (id === "s7") {
    dust.visible = false;
    const ease = (a, d = 0.4) => 1 - (1 - sm(a, a + d, u)) ** 3;
    const rise = (m, a, y0) => { const e = ease(a); m.material.opacity = e; m.position.y = y0 - 0.12 * (1 - e); };
    const e0 = ease(-0.2, 0.45); fadeMats7.forEach((m) => { m.opacity = e0; });
    BR7.forEach((g) => { const [sx, sy] = g.userData.s, o = 0.3 * (1 - e0); g.position.set(sx * (1.75 + o), 5.0 + sy * (3.25 + o), 0); });
    tBrand7.material.opacity = e0; tHead7.material.opacity = e0;
    const sp = sm(0.0, 0.9, u); scan7.position.set(0, 7.28 - 1.9 * sp, 0.01); mScan7.opacity = Math.sin(Math.PI * sp) * 0.9; // one sweep down the panel
    ROWS7.forEach((r, i) => { const e = ease(0.15 + 0.15 * i, 0.9); r.f.scale.x = 0.001 + 0.999 * e * r.score / 100; r.n.material.opacity = e0; r.n.userData.set(String(Math.round(r.score * e))); });
    rise(t9907, at("s7", "1490") + 0.2, 4.55);
    rise(tPer7, at("s7", "למשרה") - 0.05, 3.78);
    const eb = ease(at("s7", "משאירים") - 0.1); mBtn7.opacity = eb; tBtn7.material.opacity = eb; btn7.position.y = 2.72 - 0.12 * (1 - eb);
  }

  // camera
  const [cx, cy, cz, lx, ly, lz, fov] = keys(su, shot.K);
  camera.position.set(cx, cy, cz);
  camera.lookAt(lx, ly, lz);
  camera.fov = safeFov(fov);
  camera.updateProjectionMatrix();
}

function renderHook(t, id, u) {
  const eve = g("h1", "ובערב"), who = g("h1", "מי"), bench = g("h2", "ושופטים");
  const court = t >= bench;
  for (const G of [G4, G6, G7]) G.visible = false;
  GC.visible = court; G5.visible = !court; scene.fog.density = 0.03;
  if (!court) {
    // candidates rush through the chair all day while the CV pile grows and the clock runs 9:00 -> 18:00
    // each candidate slides in, sits, slides out of frame before the next: a snap back every 0.2s read as flicker
    const c0 = g("h1", "ראיינתם") - 0.05, P = (eve - c0) / 2, kc = (t - c0) / P, n = t < c0 ? 0 : Math.min(8, Math.floor(kc) + 1), ph = t < eve ? kc % 1 : Math.min(0.5, kc - 2);
    const e = sm(0, 0.3, ph) * (1 - sm(0.7, 1, ph));
    CV.forEach((c, i) => { c.visible = i < n; c.position.y = 0.83 + i * 0.026; });
    const CC = [0x9a90ff, 0xff9a5a, 0x6ad0ff, 0xe8e4ff], leave = sm(who - 0.05, who + 0.2, t);
    candidate.visible = n > 0; candidate.children.slice(0, 6).forEach((m) => (m.visible = leave < 0.98)); // the chair stays
    candidate.children[0].material.color.set(CC[n % 4]);
    candidate.scale.setScalar(Math.max(0.01, 1 - 0.3 * leave));
    candidate.position.x = 1.45 + 2.2 * (1 - e); // fully out of frame between candidates, so the colour swap is never seen
    // "who was good?": the chair is empty, a question mark hangs over it
    hQ.visible = t > who - 0.05; hQ.scale.setScalar(pop(who, t) * (1 - 0.6 * sm(g("h2", "העייפות") - 0.1, g("h2", "העייפות") + 0.3, t)));
    hClock.visible = true;
    const hr = 9 + 9 * sm(c0, eve + 0.3, t);
    hcH.rotation.z = -(hr % 12) / 12 * Math.PI * 2; hcM.rotation.z = -(hr % 1) * Math.PI * 2;
    const day = sm(c0, eve + 0.4, t);
    skyM.color.set(0x5ab0ff).lerp(new THREE.Color(0xff7a30), sm(0, 0.6, day)).lerp(new THREE.Color(0x1a1640), sm(0.6, 1, day)).multiplyScalar(0.7);
    sun.position.y = 0.28 - 0.55 * day; sun.scale.setScalar(Math.max(0.001, 1 - sm(0.75, 1, day)));
    const tired = 0.7 * sm(eve, g("h1", "זכרתם") + 0.3, t) + 0.3 * sm(g("h2", "העייפות") - 0.1, g("h2", "העייפות") + 0.4, t);
    slumpSeat(interviewer, tired); lerpMat(mInt, FRESH, TIRED, tired);
    const k = 1 - 0.8 * tired;
    bulbM.color.set(GOLD).multiplyScalar(1.6 * k); beamM.opacity = 0.1 * k; lampLight.intensity = 6 * k;
    ghost.visible = tMorning.visible = tN.visible = tInt.visible = false;
  } else {
    // the courtroom of s1, empty of s1's props: just the judge at the bench, gavel lands on "proved"
    t2011.visible = files.visible = tCount.visible = tDec.visible = cntBack.visible = flag.visible = board.visible = lunch.visible = cardG.visible = pileOk.visible = pileNo.visible = false;
    RES.forEach((r) => (r.visible = false));
    jdg.visible = true; slumpJudge(jdg, 0); lerpMat(mJudge, FRESH, TIRED, 0);
    const pr = g("h2", "הוכיחו") - 0.05;
    gavel.rotation.z = -0.8 * (1 - slam(t - pr));
    const sx = t - pr - 0.08; shock.visible = sx > 0 && sx < 0.4; shock.scale.setScalar(1 + 5 * sx); shock.material.opacity = 1 - sx / 0.4;
  }
  let shot = SHH[0];
  for (const s of SHH) if (t >= s.at) shot = s;
  const su = t - shot.at, [cx, cy, cz, lx, ly, lz, fov] = keys(su, shot.K);
  camera.position.set(cx, cy, cz); camera.lookAt(lx, ly, lz);
  camera.fov = safeFov(fov); camera.updateProjectionMatrix();
}
// leaving the hook: s5 sets everything else itself; these the hook alone touches
function resetHook() { hClock.visible = hQ.visible = false; candidate.visible = true; candidate.position.x = 1.45; candidate.children.slice(0, 6).forEach((m) => (m.visible = true)); }

const XF = 0.35, CUTS = [...SH, ...SHH].map((s) => s.at).filter((a) => a > 0).sort((a, b) => a - b);
function renderAt(t) {
  let c = -1; for (const a of CUTS) if (t >= a) c = a;
  const k = 0; // shortcut: crossfade off, prevRT capture came out empty (black cuts); fix capture before re-enabling
  mix.enabled = false;
  if (k > 0.002) {
    composer.renderToScreen = false; drawAt(c - 0.001); composer.render();
    copyPass.render(renderer, prevRT, composer.readBuffer);
    composer.renderToScreen = true; mix.enabled = true; mix.uniforms.k.value = k;
  }
  drawAt(t); composer.render();
}

window.__hf = window.__hf || {};
window.__hf.buildReady = window.__hf.buildReady || {};
window.__hf.buildReady["jobspace-world"] = Promise.all([document.fonts.load("900 100px Heebo"), document.fonts.load("800 100px Heebo")]).catch(() => {}).then(() => {
  TEXTS.forEach((p) => p());
  const t0 = window.__hfThreeTime || 0;
  renderAt(t0); renderAt(t0); // first bloom pass can come out black
});
window.addEventListener("hf-seek", (e) => renderAt(e.detail.time));
