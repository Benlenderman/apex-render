// One glowing world for the JobSpace / hungry-judges reel. Time comes only from hf-seek / __hfThreeTime.
import * as THREE from "three";
import { EffectComposer } from "three/addons/postprocessing/EffectComposer.js";
import { RenderPass } from "three/addons/postprocessing/RenderPass.js";
import { UnrealBloomPass } from "three/addons/postprocessing/UnrealBloomPass.js";
import { OutputPass } from "three/addons/postprocessing/OutputPass.js";
import { CopyShader } from "three/addons/shaders/CopyShader.js";
import { ShaderPass } from "three/addons/postprocessing/ShaderPass.js";
import { RGBShiftShader } from "three/addons/shaders/RGBShiftShader.js";
import { VignetteShader } from "three/addons/shaders/VignetteShader.js";

const { S, W, LEAD } = window.__EV;
const IDS = Object.keys(S);
const norm = (s) => s.replace(/[^א-ת0-9]/g, "");
const at = (id, word, n = 1) => {
  const hits = W[id].words.filter((w) => norm(w.text) === norm(word));
  if (!hits[n - 1]) throw new Error(`no word ${id}/${word}#${n}`);
  return hits[n - 1].start;
};
const g = (id, word, n) => S[id][0] + LEAD + at(id, word, n); // global time of a word
const sm = (a, b, x) => { const t = Math.min(1, Math.max(0, (x - a) / (b - a))); return t * t * (3 - 2 * t); };
const rng = ((s) => () => ((s = (s * 1664525 + 1013904223) >>> 0) / 4294967296))(55);

// ---------- renderer ----------
const canvas = document.getElementById("world");
const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
renderer.setPixelRatio(1);
renderer.setSize(1080, 1920, false);
renderer.toneMapping = THREE.ACESFilmicToneMapping;
const scene = new THREE.Scene();
const BG = 0x03020f;
scene.background = new THREE.Color(BG);
scene.fog = new THREE.FogExp2(BG, 0.03);
const camera = new THREE.PerspectiveCamera(45, 1080 / 1920, 0.05, 600);
// pull back 1.2x so everything stays inside the Reels safe zone (phones crop ~9% per side)
const safeFov = (f) => 2 * Math.atan(Math.tan(f * Math.PI / 360) * 1.2) * 180 / Math.PI;
scene.add(new THREE.HemisphereLight(0x6fe8ff, 0x1a0630, 2.2));
const key = new THREE.DirectionalLight(0xffffff, 2.2); key.position.set(4, 8, 6); scene.add(key);
const composer = new EffectComposer(renderer, new THREE.WebGLRenderTarget(1080, 1920, { type: THREE.HalfFloatType, samples: 4 })) // MSAA: thin neon lines stop shimmering;
composer.addPass(new RenderPass(scene, camera));
const bloom = new UnrealBloomPass(new THREE.Vector2(1080, 1920), 1.0, 0.45, 0.8);
composer.addPass(bloom);
const rgb = new ShaderPass(RGBShiftShader); rgb.uniforms.amount.value = 0.0011; composer.addPass(rgb);
const vig = new ShaderPass(VignetteShader); vig.uniforms.offset.value = 1.0; vig.uniforms.darkness.value = 1.15; composer.addPass(vig);
const txtPass = new RenderPass(scene, camera); txtPass.clear = false; txtPass.clearDepth = true;
txtPass.render = function (...a) { const bg = scene.background; scene.background = null; camera.layers.set(1); RenderPass.prototype.render.apply(this, a); camera.layers.set(0); scene.background = bg; };
composer.addPass(txtPass);
composer.addPass(new OutputPass());
// cuts dissolve: the last frame of the outgoing shot fades over the new one
const prevRT = new THREE.WebGLRenderTarget(1080, 1920, { type: THREE.HalfFloatType });
const copyPass = new ShaderPass(CopyShader);
const mix = new ShaderPass({ uniforms: { tDiffuse: { value: null }, tPrev: { value: prevRT.texture }, k: { value: 0 } }, vertexShader: CopyShader.vertexShader,
  fragmentShader: "uniform sampler2D tDiffuse, tPrev; uniform float k; varying vec2 vUv; void main() { gl_FragColor = mix(texture2D(tDiffuse, vUv), texture2D(tPrev, vUv), k); }" });
composer.addPass(mix);

const glow = (hex, k) => new THREE.MeshBasicMaterial({ color: new THREE.Color(hex).multiplyScalar(k), toneMapped: false });
const VIOLET = 0x3ee6ff, ORANGE = 0xff2fb4, GOLD = 0xffd23a;
const mFrame = glow(VIOLET, 1.5), mHot = glow(ORANGE, 2.2);
// Fresnel rim glow added to the emissive term
const holo = (mat, rim, k = 1.6) => { mat.onBeforeCompile = (sh) => { sh.uniforms.rimC = { value: new THREE.Color(rim).multiplyScalar(k) };
  sh.fragmentShader = "uniform vec3 rimC;\n" + sh.fragmentShader.replace("#include <emissivemap_fragment>", "#include <emissivemap_fragment>\n totalEmissiveRadiance += rimC * pow(max(0.0, 1.0 - abs(dot(normal, normalize(vViewPosition)))), 2.2);"); }; return mat; };
const mSolid = holo(new THREE.MeshStandardMaterial({ color: 0x1a2a6a, emissive: 0x0a1440, roughness: 0.25, metalness: 0.6 }), 0x3ee6ff, 1.0);
const mWarm = holo(new THREE.MeshStandardMaterial({ color: 0xff3cb8, emissive: 0x700050, roughness: 0.35 }), 0xffa0e8, 2.0);
const mPerson = holo(new THREE.MeshStandardMaterial({ color: 0x4a7dff, emissive: 0x10308a, roughness: 0.3, metalness: 0.3 }), 0x5ff0ff, 2.2);
const mDark = holo(new THREE.MeshStandardMaterial({ color: 0x0c1030, emissive: 0x05061a, roughness: 0.3, metalness: 0.5 }), 0x7a5cff, 0.8);
const mEdge = new THREE.LineBasicMaterial({ color: new THREE.Color(VIOLET).multiplyScalar(1.3), toneMapped: false });

function box(w, h, d, x, y, z, mat = mSolid, edges = true) {
  const geo = new THREE.BoxGeometry(w, h, d);
  const m = new THREE.Mesh(geo, mat);
  m.position.set(x, y, z);
  if (edges) m.add(new THREE.LineSegments(new THREE.EdgesGeometry(geo), mEdge));
  return m;
}
// Hebrew text on a canvas plane; redrawn once Heebo has loaded and whenever set() changes the text
const TEXTS = [];
// keep text luminance under the bloom threshold (0.8) so it stays crisp
const txtCol = (hex, k) => { const c = new THREE.Color(hex), l = 0.2126 * c.r + 0.7152 * c.g + 0.0722 * c.b; return c.multiplyScalar(Math.min(k, 1.45, 0.72 / l)); };
function text(str, width, { px = 300, color = VIOLET, k = 1.8, align = "center", aspect = 2, weight = 900 } = {}) {
  const c = document.createElement("canvas");
  c.width = 1024; c.height = 1024 / aspect;
  const tex = new THREE.CanvasTexture(c);
  const mat = new THREE.MeshBasicMaterial({ map: tex, color: txtCol(color, k), transparent: true, toneMapped: false, depthWrite: false, fog: false });
  const m = new THREE.Mesh(new THREE.PlaneGeometry(width, width / aspect), mat);
  const paint = () => {
    const x = c.getContext("2d");
    x.clearRect(0, 0, c.width, c.height);
    x.fillStyle = "#fff"; x.direction = /^[\d₪A-Za-z %]+$/.test(m.userData.str) ? "ltr" : "rtl"; x.textBaseline = "middle";
    x.textAlign = align === "right" ? "right" : "center";
    x.font = `${weight} ${px}px Heebo, Arial, sans-serif`;
    const fit = Math.min(1, 980 / x.measureText(m.userData.str).width); // never clip a long word
    if (fit < 1) x.font = `${weight} ${Math.floor(px * fit)}px Heebo, Arial, sans-serif`;
    x.fillText(m.userData.str, align === "right" ? 1000 : 512, c.height / 2);
    tex.needsUpdate = true;
  };
  m.userData.str = str;
  m.userData.set = (s) => { if (s !== m.userData.str) { m.userData.str = s; paint(); } };
  m.layers.set(1); // text skips bloom: drawn in its own pass after the glow
  TEXTS.push(paint); paint();
  return m;
}
function person(mat) { // standing, faces +z, 1.6 tall
  const p = new THREE.Group();
  const body = new THREE.Mesh(new THREE.CapsuleGeometry(0.2, 0.7, 4, 10), mat); body.position.y = 0.75;
  const head = new THREE.Mesh(new THREE.SphereGeometry(0.17, 16, 12), mat); head.position.y = 1.42;
  p.add(body, head);
  return p;
}
function seated(mat) { // sits on a chair, faces +x
  const p = new THREE.Group();
  const body = new THREE.Mesh(new THREE.CapsuleGeometry(0.21, 0.45, 4, 10), mat); body.position.set(0, 1.12, 0);
  const head = new THREE.Mesh(new THREE.SphereGeometry(0.18, 16, 12), mat); head.position.set(0.04, 1.66, 0);
  p.add(body, head, box(0.5, 0.14, 0.34, 0.22, 0.74, 0, mat, false), box(0.12, 0.7, 0.3, 0.44, 0.36, 0, mat, false));
  p.add(box(0.12, 0.38, 0.12, 0.2, 1.12, 0.2, mat, false), box(0.12, 0.38, 0.12, 0.2, 1.12, -0.2, mat, false)); // arms
  p.add(box(0.5, 0.06, 0.5, -0.02, 0.64, 0, mDark), box(0.06, 0.7, 0.5, -0.28, 1.0, 0, mDark)); // chair
  return p;
}

// ---------- floor ----------
const grid = new THREE.GridHelper(600, 400, 0x2a6cff, 0x1a3aa0);
grid.material.toneMapped = false;
scene.add(grid);
const floor = new THREE.Mesh(new THREE.PlaneGeometry(600, 600), new THREE.MeshBasicMaterial({ color: 0x02020a }));
floor.rotation.x = -Math.PI / 2; floor.position.y = -0.01;
scene.add(floor);
const DUST = new Float32Array(1500 * 3), DC = new Float32Array(1500 * 3);
for (let i = 0; i < 1500; i++) { DUST.set([-12 + rng() * 56, rng() * 12, -16 + rng() * 30], i * 3); DC.set(rng() < 0.6 ? [0.3, 0.9, 1.4] : [1.4, 0.3, 1.0], i * 3); }
const dGeo = new THREE.BufferGeometry(); dGeo.setAttribute("position", new THREE.BufferAttribute(DUST, 3)); dGeo.setAttribute("color", new THREE.BufferAttribute(DC, 3));
const dust = new THREE.Points(dGeo, new THREE.PointsMaterial({ size: 0.035, vertexColors: true, transparent: true, opacity: 0.8, toneMapped: false, depthWrite: false, blending: THREE.AdditiveBlending }));
scene.add(dust);

const GREEN = 0x4dff88, RED = 0xff4a4a;
const mCoat = holo(new THREE.MeshStandardMaterial({ color: 0xd8f6ff, emissive: 0x2a5070, roughness: 0.3, metalness: 0.2 }), 0x9af4ff, 1.6);
const mJudge = holo(new THREE.MeshStandardMaterial({ color: 0x4a7dff, emissive: 0x10308a, roughness: 0.3, metalness: 0.3 }), 0x5ff0ff, 2.2);
const mWood = holo(new THREE.MeshStandardMaterial({ color: 0x8a2a9a, emissive: 0x3a0840, roughness: 0.3, metalness: 0.4 }), 0xff60d0, 1.4);
const lerpMat = (m, a, b, k) => { m.color.setHex(a.c).lerp(new THREE.Color(b.c), k); m.emissive.setHex(a.e).lerp(new THREE.Color(b.e), k); };
const FRESH = { c: 0x4a7dff, e: 0x10308a }, TIRED = { c: 0x26346a, e: 0x05061a };
function judge(mat) { // standing judge with a white collar, faces +z
  const p = person(mat);
  p.add(box(0.14, 0.16, 0.02, 0, 1.18, 0.2, glow(0xffffff, 0.8), false));
  return p;
}
function slumpJudge(p, s) { p.rotation.x = 0.32 * s; p.children[1].position.set(0, 1.42 - 0.1 * s, 0.1 * s); }
function sandwich() {
  const s = new THREE.Group();
  s.add(new THREE.Mesh(new THREE.CylinderGeometry(0.34, 0.3, 0.03, 32), glow(0xffffff, 0.45)));
  const bread = holo(new THREE.MeshStandardMaterial({ color: 0xffc070, emissive: 0x7a4810, roughness: 0.4 }), 0xffe08a, 1.4);
  s.add(box(0.44, 0.07, 0.3, 0, 0.05, 0, bread, false), box(0.48, 0.03, 0.33, 0, 0.1, 0, glow(0x55ff66, 1.2), false),
    box(0.44, 0.03, 0.3, 0, 0.13, 0, glow(0xff3030, 1.2), false), box(0.46, 0.025, 0.31, 0, 0.16, 0, glow(GOLD, 1.0), false));
  const top = new THREE.Mesh(new THREE.CapsuleGeometry(0.07, 0.32, 4, 12).rotateZ(Math.PI / 2), bread); top.scale.z = 2.1; top.position.y = 0.22; s.add(top);
  return s;
}

// ---------- s1-s3: the courtroom ----------
const GC = new THREE.Group(); scene.add(GC);
GC.add(box(14, 14, 0.1, 0, 5, -2.35, mDark, false));
GC.add(box(3.2, 1.3, 0.9, 0, 0.65, 0, mSolid), box(3.2, 0.05, 0.02, 0, 1.18, 0.46, mFrame, false));
const emblem = new THREE.Mesh(new THREE.RingGeometry(0.2, 0.26, 40), glow(GOLD, 1.2)); emblem.position.set(0, 0.7, 0.46);
const jdg = judge(mJudge); jdg.position.set(0, 0.28, -0.65); jdg.scale.setScalar(1.12); GC.add(jdg);
// gavel: pivot at the handle end, head swings down onto the block
const block = new THREE.Mesh(new THREE.CylinderGeometry(0.17, 0.19, 0.06, 28), mWood); block.position.set(0.55, 1.33, 0.25); GC.add(block);
const gavel = new THREE.Group(); gavel.position.set(0.98, 1.47, 0.25); GC.add(gavel);
gavel.add(box(0.45, 0.04, 0.04, -0.22, 0, 0, mWood, false));
const gHead = new THREE.Mesh(new THREE.CylinderGeometry(0.08, 0.08, 0.3, 20), mWood); gHead.rotation.x = Math.PI / 2; gHead.position.set(-0.43, 0, 0); gavel.add(gHead);
const shock = new THREE.Mesh(new THREE.RingGeometry(0.2, 0.26, 48), glow(ORANGE, 2.4)); shock.rotation.x = -Math.PI / 2; shock.position.set(0.55, 1.37, 0.25); GC.add(shock);
// the decision card held up in front of the judge, stamped and sent to a pile
const cardG = new THREE.Group(); GC.add(cardG);
cardG.add(box(0.5, 0.64, 0.02, 0, 0, 0, glow(0xffffff, 0.4), false));
for (let i = 0; i < 4; i++) cardG.add(box(0.34, 0.03, 0.01, 0, 0.2 - i * 0.09, 0.015, glow(0x3a3290, 1), false));
const stOk = text("אושר", 0.5, { px: 300, color: GREEN, k: 1.6, aspect: 2.5 }), stNo = text("נדחה", 0.5, { px: 300, color: RED, k: 1.6, aspect: 2.5 });
[stOk, stNo].forEach((s) => { s.position.set(0, -0.12, 0.03); s.rotation.z = 0.18; cardG.add(s); });
const pileOk = box(0.42, 1, 0.32, -1.2, 1.3, -0.05, glow(GREEN, 0.9), false), pileNo = box(0.42, 1, 0.32, 1.25, 1.3, -0.05, glow(RED, 0.9), false);
GC.add(pileOk, pileNo);
// s1: researchers, the 2011 title, a wall of files, the flag
const t2011 = text("2011", 1.9, { px: 360, color: ORANGE, k: 1.8 }); t2011.position.set(0, 2.75, -1.0); GC.add(t2011);
const RES = [-1, 1].map((sx) => { const r = person(mCoat); r.position.set(sx * 0.95, 0, 2.3); r.rotation.y = -sx * 0.45; r.add(clip()); GC.add(r); return r; });
function clip() { const c = new THREE.Group(); c.add(box(0.26, 0.34, 0.02, 0, 0, 0, glow(0xffffff, 0.5), false), box(0.12, 0.04, 0.03, 0, 0.17, 0.01, mDark, false)); c.position.set(0.12, 0.95, 0.24); c.rotation.set(-0.5, 0, -0.15); return c; }
const NF = 96, files = new THREE.InstancedMesh(new THREE.BoxGeometry(0.3, 0.38, 0.03), new THREE.MeshBasicMaterial({ toneMapped: false }), NF), FL = [];
for (let i = 0; i < NF; i++) { FL.push({ x: -1.95 + (i % 12) * 0.355, y: 2.35 + Math.floor(i / 12) * 0.44, d: rng() }); files.setColorAt(i, new THREE.Color(i % 3 ? VIOLET : ORANGE).multiplyScalar(i % 3 ? 0.7 : 1.1)); }
GC.add(files);
const cntBack = box(2.5, 1.55, 0.04, 0, 4.25, -1.9, mDark, false); GC.add(cntBack);
const tCount = text("0", 2.2, { px: 330, color: ORANGE, k: 1.9 }); tCount.position.set(0, 4.5, -1.85); GC.add(tCount);
const tDec = text("החלטות", 1.6, { px: 260, k: 1.6, aspect: 3 }); tDec.position.set(0, 3.82, -1.85); GC.add(tDec);
const flag = new THREE.Group(); flag.position.set(-1.45, 0, -1.2); GC.add(flag);
flag.add(new THREE.Mesh(new THREE.CylinderGeometry(0.025, 0.025, 2.9, 10).translate(0, 1.45, 0), glow(GOLD, 0.8)));
const cloth = new THREE.Group(); flag.add(cloth);
cloth.add(box(0.92, 0.64, 0.01, 0.48, 0, 0, glow(0xffffff, 0.55), false), box(0.92, 0.08, 0.01, 0.48, 0.22, 0.01, glow(0x3d6bff, 1.4), false), box(0.92, 0.08, 0.01, 0.48, -0.22, 0.01, glow(0x3d6bff, 1.4), false));
[Math.PI / 2, -Math.PI / 2].forEach((r) => { const tri = new THREE.Mesh(new THREE.RingGeometry(0.1, 0.13, 3), glow(0x3d6bff, 1.4)); tri.rotation.z = r; tri.position.set(0.48, 0, 0.02); cloth.add(tri); });
// s1 end: the prisoner behind bars, at x=30
const cell = new THREE.Group(); cell.position.set(30, 0, 0); GC.add(cell);
cell.add(box(2.2, 2.6, 0.1, 0, 1.3, -0.9, mDark, false));
const bars = new THREE.Group(); cell.add(bars);
for (let i = 0; i < 7; i++) bars.add(new THREE.Mesh(new THREE.CylinderGeometry(0.035, 0.035, 2.3, 10).translate(-0.75 + i * 0.25, 1.15, 0.35), glow(VIOLET, 1.3)));
bars.add(box(1.8, 0.08, 0.08, 0, 2.3, 0.35, glow(VIOLET, 1.3), false), box(1.8, 0.08, 0.08, 0, 0.05, 0.35, glow(VIOLET, 1.3), false));
const prisoner = person(mWarm); cell.add(prisoner);
const freeLight = new THREE.Mesh(new THREE.CircleGeometry(0.42, 40), glow(GOLD, 0.6)); freeLight.rotation.x = -Math.PI / 2; freeLight.position.set(0, 0.02, 1.0); cell.add(freeLight);

// s2-s3: the approval chart on the wall behind the judge
const board = new THREE.Group(); GC.add(board);
board.add(box(3.8, 3.0, 0.06, 0, 4.45, -2.2, mDark), box(3.0, 0.03, 0.02, 0, 3.35, -2.15, glow(VIOLET, 1.2), false), box(0.03, 2.0, 0.02, -1.5, 4.35, -2.15, glow(VIOLET, 1.2), false));
const X0 = -1.5, Y0 = 3.35, YS = 1.9, yv = (v) => Y0 + v * YS;
for (let i = 0; i < 12; i++) board.add(box(0.14, 0.02, 0.01, -1.4 + i * 0.25, yv(0.65), -2.15, glow(VIOLET, 0.5), false));
const t65 = text("65%", 0.42, { px: 300, k: 1.2, aspect: 2 }); t65.position.set(-1.68, yv(0.65), -2.14); t65.visible = false;
const PTS = [[-1.5, 0.65], [-1.25, 0.57], [-1.0, 0.6], [-0.75, 0.45], [-0.5, 0.33], [-0.25, 0.17], [0, 0.0], [0.3, 0.65], [0.55, 0.62], [0.8, 0.63]];
const SEG = [];
for (let i = 0; i < PTS.length - 1; i++) {
  const [ax, av] = PTS[i], [bx, bv] = PTS[i + 1], dx = bx - ax, dy = (bv - av) * YS, L = Math.hypot(dx, dy);
  const s = new THREE.Group(); s.position.set(ax, yv(av), -2.12); s.rotation.z = Math.atan2(dy, dx); board.add(s);
  const bar = new THREE.Mesh(new THREE.PlaneGeometry(1, 0.06).translate(0.5, 0, 0), glow(ORANGE, 2.2)); s.add(bar);
  SEG.push({ s, bar, L });
}
const head = new THREE.Mesh(new THREE.SphereGeometry(0.07, 16, 12), glow(0xffffff, 1.2)); board.add(head);
const brk = box(0.03, 1.6, 0.01, 0.15, 4.15, -2.14, glow(GOLD, 0.9), false); board.add(brk);
const icon = sandwich(); icon.scale.setScalar(0.55); icon.rotation.x = 0.5; icon.position.set(0.15, 5.05, -2.0); board.add(icon);
const tPct = text("65%", 1.5, { px: 330, color: GREEN, k: 1.5 }); tPct.position.set(0.95, 5.45, -2.1); board.add(tPct);
const wclock = new THREE.Group(); wclock.position.set(-0.55, 5.3, -2.12); board.add(wclock);
wclock.add(new THREE.Mesh(new THREE.CircleGeometry(0.42, 40), glow(0x2a2470, 1)), new THREE.Mesh(new THREE.RingGeometry(0.4, 0.46, 40), glow(VIOLET, 1.8)));
const hHour = box(0.05, 0.22, 0.01, 0, 0.11, 0.02, glow(0xffffff, 0.9), false), hMin = box(0.035, 0.34, 0.01, 0, 0.17, 0.025, glow(0xffffff, 0.9), false);
const pHour = new THREE.Group(), pMin = new THREE.Group(); pHour.add(hHour); pMin.add(hMin); wclock.add(pHour, pMin);
// s3: lunch arrives
const lunch = sandwich(); lunch.position.set(0, 1.32, 0.15); GC.add(lunch);
board.add(t65);

// ---------- s4: same judges, same cases ----------
const G4 = new THREE.Group(); scene.add(G4);
const J4 = [-1, 1].map((sx) => {
  const x = sx * 1.12, mat = holo(mJudge.clone(), 0x5ff0ff, 2.2);
  G4.add(box(1.5, 1.0, 0.6, x, 0.5, 0, mSolid));
  const j = judge(mat); j.position.set(x, 0.15, -0.45); G4.add(j);
  const folder = new THREE.Group(); folder.position.set(x, 1.12, 0.25); folder.rotation.x = -0.6; G4.add(folder);
  folder.add(box(0.5, 0.36, 0.03, 0, 0, 0, mWarm, false), box(0.2, 0.06, 0.03, -0.12, 0.2, 0, mWarm, false), box(0.42, 0.3, 0.01, 0, -0.01, 0.02, glow(0xffffff, 0.4), false));
  const lab = text(sx < 0 ? "בבוקר" : "לפני ההפסקה", 1.2, { px: 230, color: sx < 0 ? GREEN : ORANGE, k: 1.5, aspect: 4 }); lab.position.set(x * 0.88, 2.5, 0); G4.add(lab);
  return { j, mat, folder, lab };
});
const eqs = new THREE.Group(); eqs.position.set(0, 1.45, 0.2); G4.add(eqs);
eqs.add(box(0.3, 0.06, 0.02, 0, 0.07, 0, glow(0xffffff, 1.2), false), box(0.3, 0.06, 0.02, 0, -0.07, 0, glow(0xffffff, 1.2), false));
const ZZ = [0, 1, 2].map((i) => { const z = text("Z", 0.3 + i * 0.08, { px: 600, aspect: 1, color: VIOLET, k: 1.6 }); G4.add(z); return z; });
